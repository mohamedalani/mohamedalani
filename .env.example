# Modèle de configuration — COPIE ce fichier en ".env" et remplis tes vraies valeurs
# Commande : cp .env.example .env
#
# Ce fichier (.env.example) EST committé dans git : il ne contient aucun secret,
# juste la liste des variables attendues. Le vrai ".env" reste privé (ignoré par git).

# Exemples de variables (adapte selon tes besoins) :
APP_NAME=mon-site
APP_ENV=development
APP_PORT=80

# Clés / secrets (mets tes vraies valeurs dans .env, jamais ici)
API_KEY=
SECRET_KEY=
